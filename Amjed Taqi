<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Heat Index Safety Instrument</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: { 900: '#0f172a', 800: '#1e293b', 700: '#334155' }
                    }
                }
            }
        }
    </script>
    <link rel="manifest" href='data:application/manifest+json,{
        "name": "Heat Index Safety",
        "short_name": "HeatIndex",
        "start_url": "./index.html",
        "display": "standalone",
        "background_color": "#0f172a",
        "theme_color": "#0f172a",
        "icons": [{
            "src": "data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><rect width=\'100\' height=\'100\' rx=\'20\' fill=\'%230f172a\'/><circle cx=\'35\' cy=\'35\' r=\'18\' fill=\'%23fbbf24\'/><path d=\'M50 50 Q60 30 75 45 T90 60\' fill=\'none\' stroke=\'%2394a3b8\' stroke-width=\'6\' stroke-linecap=\'round\'/><rect x=\'20\' y=\'70\' width=\'15\' height=\'10\' fill=\'%234ade80\'/><rect x=\'42\' y=\'70\' width=\'15\' height=\'10\' fill=\'%23fbbf24\'/><rect x=\'64\' y=\'70\' width=\'15\' height=\'10\' fill=\'%23ef4444\'/></svg>",
            "sizes": "192x192",
            "type": "image/svg+xml"
        }]
    }'>
</head>
<body class="bg-navy-900 text-slate-100 min-h-screen font-sans antialiased pb-10">

    <div class="max-w-md mx-auto p-4 space-y-5">
        
        <header class="flex items-center justify-between pt-2 pb-1 border-b border-navy-700">
            <div class="flex items-center space-x-3 space-x-reverse">
                <div class="w-10 h-10 bg-navy-800 rounded-xl flex items-center justify-center p-1 border border-navy-700 shadow-md">
                    <svg viewBox="0 0 100 100" class="w-full h-full">
                        <circle cx="35" cy="35" r="16" fill="#fbbf24"/>
                        <path d="M45 45 Q55 25 70 40 T85 55" fill="none" stroke="#94a3b8" stroke-width="8" stroke-linecap="round"/>
                        <rect x="15" y="72" width="20" height="10" rx="2" fill="#4ade80"/>
                        <rect x="40" y="72" width="20" height="10" rx="2" fill="#fbbf24"/>
                        <rect x="65" y="72" width="20" height="10" rx="2" fill="#ef4444"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight text-white">Heat Index Instrument</h1>
                    <p class="text-xs text-slate-400">Professional Safety Assistant</p>
                </div>
            </div>
            <button id="modeToggle" class="text-xs bg-navy-800 hover:bg-navy-700 border border-navy-700 px-3 py-1.5 rounded-lg text-blue-400 font-medium transition">MANUAL</button>
        </header>

        <main class="bg-navy-800 border border-navy-700 rounded-2xl p-5 shadow-xl space-y-4">
            <div class="flex justify-between items-center text-xs text-slate-400 font-semibold tracking-wider">
                <span>APPARENT TEMPERATURE</span>
                <span id="unitLabel">°C</span>
            </div>

            <div class="text-center py-2">
                <div class="text-5xl font-extrabold tracking-tight text-white" id="heatIndexVal">36</div>
                <div class="text-xs text-blue-400 font-semibold mt-1 uppercase tracking-widest" id="feelsLikeText">FEELS LIKE</div>
            </div>

            <div id="riskBanner" class="p-4 rounded-xl border transition-all duration-300 bg-amber-500/10 border-amber-500/30 text-amber-300 flex items-start space-x-3 space-x-reverse">
                <div id="riskIcon" class="text-xl">⚠️</div>
                <div>
                    <h2 id="riskTitle" class="font-bold text-sm">Extreme Caution · 32.2–39.4°C</h2>
                    <p id="riskDesc" class="text-xs text-slate-300 mt-0.5">Heat cramps and heat exhaustion possible with prolonged exposure.</p>
                </div>
            </div>
        </main>

        <button onclick="fetchLiveWeather()" class="w-full bg-navy-800 hover:bg-navy-700 border border-navy-700 p-4 rounded-2xl flex items-center justify-between transition shadow-md group">
            <div class="flex items-center space-x-3 space-x-reverse">
                <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center group-hover:scale-105 transition">
                    📍
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold text-white">Use my location</div>
                    <div class="text-xs text-slate-400">Live temperature & humidity via GPS</div>
                </div>
            </div>
            <span class="text-slate-500">›</span>
        </button>

        <section id="manualSection" class="bg-navy-800 border border-navy-700 rounded-2xl p-5 space-y-4 shadow-xl">
            <div class="text-xs font-semibold text-slate-400 tracking-wider">MANUAL READING</div>
            
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-300">Air temperature</span>
                    <span id="tempDisplay" class="font-bold text-blue-400">32.0 °C</span>
                </div>
                <input type="range" id="tempRange" min="15" max="50" step="0.5" value="32" class="w-full accent-blue-500 bg-navy-700 rounded-lg cursor-pointer h-2">
            </div>

            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-300">Relative humidity</span>
                    <span id="humDisplay" class="font-bold text-blue-400">55%</span>
                </div>
                <input type="range" id="humRange" min="0" max="100" step="1" value="55" class="w-full accent-blue-500 bg-navy-700 rounded-lg cursor-pointer h-2">
            </div>
        </section>

        <section class="bg-navy-800 border border-navy-700 rounded-2xl p-5 space-y-4 shadow-xl">
            <div class="text-xs font-semibold text-slate-400 tracking-wider">SAFETY GUIDANCE</div>
            
            <div class="space-y-3 text-xs">
                <div class="flex items-start space-x-3 space-x-reverse">
                    <span class="text-blue-400 text-base">💧</span>
                    <div>
                        <strong class="text-slate-200 block text-sm">Water intake</strong>
                        <span id="waterAdvice" class="text-slate-400">1–1.2 L (4–5 cups) per hour; alternate water with electrolyte drinks.</span>
                    </div>
                </div>
                <div class="flex items-start space-x-3 space-x-reverse">
                    <span class="text-blue-400 text-base">⏱️</span>
                    <div>
                        <strong class="text-slate-200 block text-sm">Work / rest cycle</strong>
                        <span id="restAdvice" class="text-slate-400">Work/rest ratio ~30 min work : 30 min shaded, cooled rest per hour.</span>
                    </div>
                </div>
                <div class="flex items-start space-x-3 space-x-reverse">
                    <span class="text-blue-400 text-base">⚠️</span>
                    <div>
                        <strong class="text-slate-200 block text-sm">Watch for</strong>
                        <span class="text-slate-400">Nausea, rapid pulse, confusion, cool/clammy skin, fainting.</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-navy-800 border border-navy-700 rounded-2xl p-5 space-y-3 shadow-xl text-xs">
            <div class="text-xs font-semibold text-slate-400 tracking-wider">RISK SCALE</div>
            <div class="space-y-2">
                <div class="flex items-center justify-between p-2 rounded-lg bg-green-500/10 border border-green-500/20 text-green-400">
                    <div class="flex items-center space-x-2 space-x-reverse"><span class="w-2.5 h-2.5 rounded-full bg-green-400"></span><span class="font-medium">Caution (Green Flag)</span></div>
                    <span>&lt; 80°F / 26.7°C</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-yellow-500/10 border border-yellow-500/20 text-yellow-400">
                    <div class="flex items-center space-x-2 space-x-reverse"><span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span><span class="font-medium">Extreme Caution (Yellow Flag)</span></div>
                    <span>80–90°F / 26.7–32.2°C</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400">
                    <div class="flex items-center space-x-2 space-x-reverse"><span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span><span class="font-medium">Danger (Red Flag)</span></div>
                    <span>91–103°F / 32.8–39.4°C</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400">
                    <div class="flex items-center space-x-2 space-x-reverse"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span><span class="font-medium">Extreme Danger (Severe Red)</span></div>
                    <span>≥ 104°F / 40°C</span>
                </div>
            </div>
        </section>

    </div>

    <script>
        const tempRange = document.getElementById('tempRange');
        const humRange = document.getElementById('humRange');
        const tempDisplay = document.getElementById('tempDisplay');
        const humDisplay = document.getElementById('humDisplay');
        const heatIndexVal = document.getElementById('heatIndexVal');
        const riskBanner = document.getElementById('riskBanner');
        const riskTitle = document.getElementById('riskTitle');
        const riskDesc = document.getElementById('riskDesc');
        const riskIcon = document.getElementById('riskIcon');
        const waterAdvice = document.getElementById('waterAdvice');
        const restAdvice = document.getElementById('restAdvice');

        function calculateHeatIndex(T_c, RH) {
            const T = T_c * 9/5 + 32;
            if (T < 80) return T_c;
            
            let HI = -42.379 + 2.04901523 * T + 10.14333127 * RH - 0.22475541 * T * RH 
                     - 0.00683783 * T * T - 0.05481717 * RH * RH 
                     + 0.00122874 * T * T * RH + 0.00085282 * T * RH * RH 
                     - 0.00000199 * T * T * RH * RH;

            if (RH < 13 && T >= 80 && T <= 112) {
                let adjustment =((13 - RH) / 4) * Math.sqrt((17 - Math.abs(T - 95)) / 17);
                HI -= adjustment;
            } else if (RH > 85 && T >= 80 && T <= 87) {
                let adjustment = ((RH - 85) / 10) * ((87 - T) / 5);
                HI += adjustment;
            }

            return (HI - 32) * 5/9;
        }

        function updateUI() {
            const t = parseFloat(tempRange.value);
            const rh = parseFloat(humRange.value);

            tempDisplay.innerText = t.toFixed(1) + ' °C';
            humDisplay.innerText = rh + '%';

            const hiCelsius = calculateHeatIndex(t, rh);
            heatIndexVal.innerText = hiCelsius.toFixed(1);

            let bannerClass = "";
            let titleText = "";
            let descText = "";
            let iconText = "";
            let waterText = "";
            let restText = "";

            if (hiCelsius < 26.7) {
                bannerClass = "bg-green-500/10 border-green-500/30 text-green-300";
                iconText = "🟢";
                titleText = `Caution (Green Flag) · < 26.7°C`;
                descText = "Fatigue possible with prolonged exposure and physical activity.";
                waterText = "0.5 L per hour; stay normally hydrated.";
                restText = "Normal work schedule with standard breaks.";
            } else if (hiCelsius >= 26.7 && hiCelsius < 32.2) {
                bannerClass = "bg-yellow-500/10 border-yellow-500/30 text-yellow-300";
                iconText = "🟡";
                titleText = `Extreme Caution (Yellow Flag) · 26.7–32.2°C`;
                descText = "Sunstroke, heat cramps, and heat exhaustion possible.";
                waterText = "0.75 L per hour; keep regular water breaks.";
                restText = "45 min work : 15 min rest per hour.";
            } else if (hiCelsius >= 32.2 && hiCelsius < 40) {
                bannerClass = "bg-orange-500/10 border-orange-500/30 text-orange-300";
                iconText = "🚩";
                titleText = `Danger (Red Flag) · 32.8–39.4°C`;
                descText = "Heat cramps and heat exhaustion likely; heat stroke possible with continued exposure.";
                waterText = "1–1.2 L (4–5 cups) per hour; alternate with electrolyte drinks.";
                restText = "30 min work : 30 min shaded, cooled rest per hour.";
                if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
            } else {
                bannerClass = "bg-red-500/10 border-red-500/30 text-red-300";
                iconText = "🚨";
                titleText = `Extreme Danger (Severe Red Flag) · ≥ 40°C`;
                descText = "Heat stroke highly likely. Emergency conditions! Stop non-essential outdoor work.";
                waterText = "Max hydration with electrolytes; frequent small sips.";
                restText = "Cease strenuous outdoor activity or strict emergency rotation.";
                if (navigator.vibrate) navigator.vibrate([300, 150, 300, 150, 300]);
            }

            riskBanner.className = `p-4 rounded-xl border transition-all duration-300 flex items-start space-x-3 space-x-reverse ${bannerClass}`;
            riskIcon.innerText = iconText;
            riskTitle.innerText = titleText;
            riskDesc.innerText = descText;
            waterAdvice.innerText = waterText;
            restAdvice.innerText = restText;
        }

        tempRange.addEventListener('input', updateUI);
        humRange.addEventListener('input', updateUI);

        function fetchLiveWeather() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser');
                return;
            }
            navigator.geolocation.getCurrentPosition(async (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                try {
                    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m`);
                    const data = await res.json();
                    if(data.current) {
                        tempRange.value = data.current.temperature_2m;
                        humRange.value = data.current.relative_humidity_2m;
                        updateUI();
                    }
                } catch (e) {
                    alert('Could not fetch live weather data.');
                }
            }, () => {
                alert('Unable to retrieve your location.');
            });
        }

        updateUI();
    </script>
</body>
</html>
